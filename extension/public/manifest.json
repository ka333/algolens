{
  "manifest_version": 3,
  "name": "AlgoLens",
  "key": "MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQCzGdaPmKKRMiXeRztfo6ER9bw1s87hXCxm0i1lTA8gd83Dbj6EA9Dy0tK3XltroftU1/0PHUr0V1h04QkVS2s1st9E9WtVdbdAYW/A58idkf1SqFEVTq3MGT+vUzliXfu9sU5xl6HlXIvYsoj67m3+rppTJQPpP0Z08qnuQlqE4QIDAQAB",
  "version": "0.1.0",
  "description": "Privacy-first Chrome extension for LeetCode analytics, GitHub automation, and benchmarking.",
  "permissions": [
    "storage",
    "notifications",
    "cookies"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*"
      ],
      "js": [
        "interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://leetcode.com/problems/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_popup": "index.html",
    "default_title": "AlgoLens Panel"
  }
}